
<!-- include header -->
<%- include('include/_header') %>
<!-- /include header -->

  <!-- Main Site -->
  <main id="site-main">
    <div class="container">
        <div class="box-nav d-flex justify-between">
           <div class="filter">
               <a href="/"><span class="text-gradient"><i class="fas fa-angle-double-left"></i> All Players</span></a>
           </div>
        </div>
        <div class="section-head text-center">
            <span class="eyebrow teal">Roster</span>
            <h1 class="section-heading">New Player</h1>
            <p class="section-sub">Create a new player</p>
        </div>

        <!-- add user form -->
        <div class="card card-pad">
        <%- include('include/_form') %>
        </div>

    </div>
</main>
<script>
        document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            window.location.href = "/";
        }
    });
</script>

