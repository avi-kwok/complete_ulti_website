
<%- include('include/_header') %>


    <main id="site-main">
        <div class="container">
            <div class="section-head with-action">
                <div>
                    <span class="eyebrow">Roster</span>
                    <h1 class="section-heading">Player List</h1>
                </div>
                <a href="/add-user" class="btn-create" id="newPlayer">New Player <i class="fas fa-user"></i></a>
            </div>

            <form action="/" method="POST">
                <div class="table-card">
                <table class="table">
                    <thead class="thead-dark">
                        <tr>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Number</th>
                            <th>Gender</th>
                            <th>Position</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th>Note</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%- include('include/_show') %>
                    </tbody>
                </table>
                </div>
            </form>
        </div>
    </main>


<%- include('include/_footer') %>


