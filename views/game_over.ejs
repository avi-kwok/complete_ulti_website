<%- include('include/_gameheader') %>

<main id="site-main">
    <div class="container">
        <div class="box-nav d-flex">
            <a id="backButton" href="/match-history" class="text-gradient"><i class="fas fa-angle-double-left"></i> Back </a>
        </div>
        <form>
            <div class="table-card">
            <table class="table">
                <thead>
                    <tr id="head">
                        <th>Name</th>
                        <th>Final Score</th>
                        <th>Date</th>
                        <th>Starting</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                        <tr id="dataBody">
                            <td><%= selectedMatch.team%></td>
                            <td><%= selectedMatch.ourScore %><%= "-" %><%= selectedMatch.theirScore %></td>
                            <td><%= selectedMatch.date %></td>
                            <td><%= selectedMatch.od%></td>
                            <td><%= selectedMatch.location%></td>
                        </tr>
            </tbody>
        </table>
        </div>
        <table>
            <thead>
                <tr>
                    <th class="forever hidden"></th>
                    <th class="forever hidden"></th>
                    <th class="forever hidden"></th>
                    <th class="forever hidden"></th>
                    <th class="forever hidden"></th>
                </tr>
            </thead>
        </table>
    </form>

    <form>
            <div class="table-card">
            <table class="table">
                <thead>
                    <tr id="head2">
                        <th>Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <% let checker = false %>
                <tbody>
                            <% selectedMatch.eventList.forEach(eventArray => { %>
                                <tr>
                                    <% if (Number.isInteger(parseInt(eventArray[0].charAt(0)))){ %>
                                        <tr id="pointBreak">
                                            <th colspan="2"><%= eventArray %></th>
                                        </tr>
                                            
                                    <% } else if (eventArray == "Opponents scored") {%>
                                        <tr>
                                            <th id="opp" colspan="2"><%= eventArray %></th>
                                        </tr>
                                        <% } else {%>
                                            <% if (eventArray[1] == "Goal" || eventArray[1] == "Assist"){ %>
                                                <td id="notOpp"><%= eventArray[0] %></td>
                                                <td id="notOpp"><%= eventArray[1] %></td>
                                            <% } else { %>
                                                <td><%= eventArray[0] %></td>
                                                <td><%= eventArray[1] %></td>
                                            <% } %>
                                        <% } %>
                                </tr>
                            <% }) %>
                </tbody>

            </table>
            </div>
        </form>
    </div>
</main>

<script>
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            const backButton = document.getElementById('backButton');
            if (backButton) {
                backButton.click();
            }
        }
    });
</script>


<style>
    #head,
    #head2,
    #pointBreak {
        background-color: var(--card-sunken);
        color: var(--text-tiny);
        text-transform: uppercase;
        letter-spacing: .05em;
        font-size: .75rem;
        font-weight: 600;
    }

    #head2 {
        text-align: center;
    }

    #notOpp{
        background-color: var(--emerald-soft);
        color: var(--text);
    }

    #opp {
        background-color: var(--rose-soft);
        color: var(--text);
    }
</style>

<%- include('include/_footer') %>
