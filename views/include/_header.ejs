<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultimate Website</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" integrity="sha512-+4zCK9k+qNFUR5X+cKL9EIR+ZOhtIloNl9GIKS57V1MyNsYpYcUrUeQc9vNfzsWfV28IaLL3i96P9sdNyeRssA==" crossorigin="anonymous" />
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Header -->
    <header id="header">
        <nav>
            <div class="container">
                <div class="nav-row">
                    <a class="nav-brand" href="/"><span class="nav-dot"></span>Ultimate Tracker</a>
                    <div class="nav-links">
                        <a href="/" class="nav-link" id="navHome">Players</a>
                        <a href="/leaderboard" class="nav-link" id="navLeaderboard">Leaderboard</a>
                        <a href="/match-history" class="nav-link" id="navMatches">Matches</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- /Header -->

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            try {
                const path = window.location.pathname;

                // Mark the active nav link
                const navActiveMap = {
                    navHome: path === '/',
                    navLeaderboard: path.includes('/leaderboard'),
                    navMatches: path.includes('/match-history')
                };
                Object.keys(navActiveMap).forEach(function(id) {
                    if (navActiveMap[id]) {
                        const el = document.getElementById(id);
                        if (el) el.classList.add('active');
                    }
                });
            } catch (error) {
                console.error('Error in script:', error);
            }
        });
    </script>
