<%- include('include/_header') %>

<main id="site-main">
    <div class="container">
        <div class="section-head with-action">
            <div>
                <span class="eyebrow">Archive</span>
                <h1 class="section-heading">Match History</h1>
            </div>
            <a href="/start-game" class="btn-create">New Match <i class="fas fa-futbol"></i></a>
        </div>

        <div class="box-nav d-flex justify-between">
            <a id="backButton" onclick="showAllData()" class="text-gradient hidden"><i class="fas fa-angle-double-left"></i> Back</a>
        </div>

        <form>
            <div class="table-card plain">
            <table class="table">
                    <thead>
                        <tr id="head" class="hidden">
                            <th>Name</th>
                            <th>Final Score</th>
                            <th>Date</th>
                            <th>Starting</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (matchHistory.length == 0){ %>
                            <tr class="head">
                                <th><div class="match-bubble match-bubble-empty">No previous match histories recorded.</div></th>
                            </tr>
                            <% } %>
                        <% for(let i = 0; i < matchHistory.length; i++) { %>
                            <tr class="showDataHide table-row <%= matchHistory[i].win ? 'win' : 'loss' %>" onclick="showData(this)" id="<%= i %>" >
                                <td>
                                    <div class="match-bubble">
                                        <div class="match-info">
                                            <div class="match-team">vs. <%= matchHistory[i].team %></div>
                                            <div class="match-date"><%= matchHistory[i].date %></div>
                                        </div>
                                        <div class="match-score"><%= matchHistory[i].ourScore %>&ndash;<%= matchHistory[i].theirScore %></div>
                                        <div class="match-actions">
                                            <a id="deletebut" class="delete" data-id="<%= matchHistory[i]._id %>" onclick="no()" title="Delete">
                                                <span class="xBut"><i class="fas fa-times"></i></span>
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <tr class="hidden" id="dataBody">
                                <td><%= matchHistory[i].team%></td>
                                <td><%= matchHistory[i].ourScore %><%= "-" %><%= matchHistory[i].theirScore %></td>
                                <td><%= matchHistory[i].date %></td>
                                <td><%= matchHistory[i].od%></td>
                                <td><%= matchHistory[i].location%></td>
                            </tr>
                        <% }; %>
                </tbody>
            </table>
            </div>
            <table>
                <thead>
                    <tr>
                        <th class="forever hidden"></th>
                        <th class="forever hidden"></th>
                        <th class="forever hidden"></th>
                        <th class="forever hidden"></th>
                        <th class="forever hidden"></th>
                    </tr>
                </thead>
            </table>

        </form>
        <form>
            <div class="table-card">
            <table class="table">
                <thead>
                    <tr class="hidden" id="head2">
                        <th>Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <% let checker = false %>
                <% for(let j = 0; j < matchHistory.length; j++) { %>
                <tbody class="hidden" id="dataBody2">
                            <% matchHistory[j].eventList.forEach(eventArray => { %>
                                <tr>
                                    <% if (Number.isInteger(parseInt(eventArray[0].charAt(0)))){ %>
                                        <% if (!checker) { %>
                                        <tr id="pointBreak">
                                            <th colspan="2"><%= eventArray %></th>
                                        </tr>
                                        <% checker = true %>
                                        <% } else {checker = false} %>
                                    <% } else if (eventArray == "Opponents scored") {%>
                                        <tr>
                                            <th id="opp" colspan="2" ><%= eventArray %></th>
                                        </tr>
                                        <% checker = false %>
                                    <% } else {%>
                                        <% if (eventArray[1] == "Goal" || eventArray[1] == "Assist"){ %>
                                            <td id="notOpp"><%= eventArray[0] %></td>
                                            <td id="notOpp"><%= eventArray[1] %></td>
                                        <% } else { %>
                                            <td><%= eventArray[0] %></td>
                                            <td><%= eventArray[1] %></td>
                                        <% } %>
                                        <% checker = false %>
                                    <% } %>
                                </tr>
                            <% }) %>
                </tbody>
                <% }; %>
            </table>
            </div>
        </form>
    </div>
</main>

<script>
    let currentIndex;
    let xstop;

    function no (){
        xstop = false;
    }

    //change button based on WL
    function changeColour(row) {
        if (row.classList.contains('win')) {
            row.classList.remove('win');
            row.classList.add('loss');
        } else {
            row.classList.remove('loss');
            row.classList.add('win');
        }
    }

    //seamless transitions
    function showData(row) {
        if (!xstop){
            xstop = true;
            return;
        }
        document.querySelectorAll('.hidden').forEach(element => {
            element.classList.remove('hidden');
            element.classList.add('jeb');
        });
        document.querySelectorAll('.showDataHide').forEach(element => {
            element.classList.add('hidden');
        });

        currentIndex = row.id;
        let x=0;
        document.querySelectorAll('#dataBody').forEach(element => {
            if (x != currentIndex){
                element.classList.add('hidden');
            }
            
            x++;
        })

        x=0;
        document.querySelectorAll('#dataBody2').forEach(element => {
            if (x != currentIndex){
                
                element.classList.add('hidden');
            }
            x++;
        })
    }

    function showAllData() {
        document.querySelectorAll('#showDataHide').forEach(element => {
            element.classList.remove('hidden');
        });

        document.querySelectorAll('.jeb').forEach(element => {
            element.classList.add('hidden');
        });
        document.querySelectorAll('.showDataHide').forEach(element => {
            element.classList.remove('hidden');
        });
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            showAllData();
        }
    });

    function getCurrentIndex () {
        return currentIndex;
    }

</script>


<style>
    /* Match bubble rows */
    .match-bubble {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
        border-radius: 1rem;
        border: 1px solid var(--border);
        background-color: var(--card);
        padding: .9rem 1.15rem;
        margin: .6rem 0;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease;
    }

    .match-info {
        text-align: left;
    }

    .match-team {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text);
    }

    .match-date {
        margin-top: .15rem;
        font-size: .75rem;
        letter-spacing: .04em;
        color: var(--text-tiny);
    }

    .match-score {
        justify-self: center;
        font-size: 1.5rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--text);
    }

    .match-actions {
        justify-self: end;
    }

    .match-bubble-empty {
        grid-template-columns: 1fr;
        text-align: center;
        color: var(--text-muted);
        cursor: default;
    }

    .table-row.win .match-bubble {
        background-color: var(--emerald-soft);
    }

    .table-row.win:hover .match-bubble {
        background-color: var(--emerald-soft-strong);
    }

    .table-row.loss .match-bubble {
        background-color: var(--rose-soft);
    }

    .table-row.loss:hover .match-bubble {
        background-color: var(--rose-soft-strong);
    }

    .table-row:hover {
        cursor: pointer;
    }

    .table-row td {
        padding: 0;
        border-top: none;
    }

    .table tbody tr.table-row:hover {
        background-color: transparent;
    }

    .table tbody tr.table-row:hover td {
        color: inherit;
    }

    /* The first table just hosts bubbles — let it sit flush with the page,
       fill the width, and not force a horizontal scrollbar. */
    .table-card.plain .table {
        min-width: 0;
        width: 100%;
    }

    .table-card.plain .table th {
        padding: 0;
        border-top: none;
    }

    .xBut {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        font-size: 1.1rem;
        border-radius: .625rem;
        border: 1px solid var(--border);
        color: var(--danger);
        cursor: pointer;
        transition: border-color .15s ease, background-color .15s ease;
    }

    .xBut:hover {
        border-color: var(--danger);
        background-color: var(--rose-soft);
    }

    #head,
    #head2,
    #pointBreak {
        background-color: var(--card-sunken);
        color: var(--text-tiny);
        text-transform: uppercase;
        letter-spacing: .05em;
        font-size: .75rem;
        font-weight: 600;
    }

    #head2 {
        text-align: center;
    }

    #notOpp{
        background-color: var(--emerald-soft);
        color: var(--text);
    }

    #opp {
        background-color: var(--rose-soft);
        color: var(--text);
    }

    .table td {
        border: 0cm;
    }

    .hidden {
        display: none;
    }

    #backButton {
        cursor: pointer;
    }

    .forever {
        color: var(--bg);
    }

    #dataBody2 {
        text-align: center;
    }
</style>


<%- include('include/_footer') %>
            